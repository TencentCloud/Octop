# Node
# hatchling only honours the ROOT .gitignore when collecting sdist files, so a
# nested plugins/openclaw/octopmemory/.gitignore is not enough: a local
# `npm install` (373MB / ~17k files) ends up inside the published sdist.
node_modules/

