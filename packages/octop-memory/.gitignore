# Personal assistant settings; shared project rules live in AGENTS.md.
# Track the shared publish skill (Octop-style); ignore everything else under these dirs.
/.codebuddy/*
!/.codebuddy/skills/
!/.codebuddy/skills/publish/
!/.codebuddy/skills/publish/**
/.cursor/*
!/.cursor/skills/
!/.cursor/skills/publish/
!/.cursor/skills/publish/**
/.claude/
