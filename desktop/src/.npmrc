# pnpm 11+ reads ONLY registry/auth settings from .npmrc. Everything else
# (nodeLinker, allowBuilds, …) belongs in pnpm-workspace.yaml.
#
# Pin the registry so local installs cannot re-pollute pnpm-lock.yaml with a
# mirror-specific tarball host (see dashboard/.npmrc for the same reasoning).
registry=https://registry.npmjs.org

# The pnpm version itself is pinned in package.json:
#   "packageManager": "pnpm@12.15.0"          — read by corepack
#   "devEngines": { "packageManager": … }     — pnpm 12's native check
# and mirrored in ../../mise.toml (+ this package's mise.toml for Node) so
# `mise install` puts the same binary on PATH. pnpm 12 no longer reads
# `package-manager-strict` / `manage-package-manager-versions`; a mismatched
# pnpm fails with ERR_PNPM_BAD_PM_VERSION by default.
