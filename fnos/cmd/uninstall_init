#!/bin/bash
# Octop — 卸载前回调
# 根据卸载向导 wizard_delete_data 的选择：
#   - 保留数据：不清理 /vol1/@appshare/octop/data。
#   - 完全删除：在 uninstall_callback 中清理 data-share。
# 同时释放 Octop 端口（8088=Docker 版，8089=本地版），避免卸载后残留进程占端口。
set -euo pipefail

log() { echo "[octop] $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true; }

free_octop_ports() {
    local port pid pids
    for port in 8088 8089; do
        pids="$(ss -ltnp 2>/dev/null | grep -E "[:.]${port}([[:space:]]|$)" | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | sort -u)" || true
        if [ -z "$pids" ] && command -v fuser >/dev/null 2>&1; then
            pids="$(fuser "${port}/tcp" 2>/dev/null | tr -cs '[:digit:]' ' ')" || true
        fi
        if [ -z "$pids" ] && command -v lsof >/dev/null 2>&1; then
            pids="$(lsof -ti tcp:"$port" 2>/dev/null)" || true
        fi
        for pid in $pids; do
            [ -n "$pid" ] || continue
            if kill -TERM "$pid" 2>/dev/null; then
                log "已发送 TERM 给占用 ${port} 的进程 ${pid}"
            fi
        done
        sleep 1
        for pid in $pids; do
            [ -n "$pid" ] || continue
            if kill -0 "$pid" 2>/dev/null; then
                kill -KILL "$pid" 2>/dev/null || true
                log "已强制 KILL 占用 ${port} 的进程 ${pid}"
            fi
        done
    done
}

free_octop_ports

if [ "${wizard_delete_data:-no}" = "yes" ]; then
    log "用户选择完全删除数据，将在 uninstall_callback 中清理 /vol1/@appshare/octop/data"
else
    log "用户选择保留数据，/vol1/@appshare/octop/data 将保留"
fi

exit 0
