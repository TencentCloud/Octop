#!/bin/bash
#
# Octop 本地版（原生 app）— 生命周期管理
# 直接以进程方式运行在飞牛主机上（非 Docker），监听 0.0.0.0:8089。
# start:  启动 Octop（后台，写 PID 文件）；端口未就绪则失败并写出原因
# stop:   发送 SIGTERM，超时 SIGKILL
# status: 查询进程状态
#

set -uo pipefail

_OCTOP_COMMON="$(dirname "$0")/common.sh"
[ -f "$_OCTOP_COMMON" ] || _OCTOP_COMMON="/var/apps/octop-native/cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] && source "$_OCTOP_COMMON"

APPDEST="${TRIM_APPDEST:-/var/apps/octop-native}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/octop-native/var}"
LOG_FILE="${PKGVAR}/info.log"
PID_FILE="${PKGVAR}/octop.pid"
PORT="${OCTOP_PORT:-8089}"
# .env 里的 OCTOP_PORT 才是实际监听端口（bin/octop source .env 时会覆盖继承的环境变量），
# 就绪探测必须跟着同一个值，否则改过端口的实例会被这里判成「起不来」并 TERM 掉。
if type octop_effective_port >/dev/null 2>&1; then
    PORT="$(octop_effective_port "${PKGVAR}/.env" "$PORT")"
fi
BIN="$APPDEST/bin/octop"
START_WAIT_SECS="${OCTOP_START_WAIT_SECS:-90}"

if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
else
    DATA_DIR="${APPDEST}/shares/octop-native/data"
fi

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"; }

port_ready() {
    nc -z 127.0.0.1 "$PORT" 2>/dev/null && return 0
    (exec 3<>/dev/tcp/127.0.0.1/"$PORT") 2>/dev/null && return 0
    return 1
}

run_as_service() {
    if id octop-native >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
        runuser -u octop-native -- "$@"
    else
        "$@"
    fi
}

fail_start() {
    local reason="$1"
    local detail
    detail="$(tail -n 40 "${LOG_FILE}" 2>/dev/null || true)"
    mkdir -p "${PKGVAR}" "${DATA_DIR}" 2>/dev/null || true
    {
        echo "$reason"
        echo
        echo "---- ${LOG_FILE} ----"
        echo "$detail"
    } > "${PKGVAR}/last-error.txt" 2>/dev/null || true
    {
        echo "$reason"
        echo
        echo "---- ${LOG_FILE} ----"
        echo "$detail"
    } > "${DATA_DIR}/octop-start-error.txt" 2>/dev/null || true
    echo "[octop-native] $reason" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
    echo "[octop-native] $reason" >&2 || true
    [ -n "$detail" ] && echo "$detail" >&2 || true
    log_msg "$reason"
    return 1
}

start_process() {
    if status; then return 0; fi
    mkdir -p "${PKGVAR}" "${DATA_DIR}"
    : >> "${LOG_FILE}"
    chmod +x "$BIN" 2>/dev/null || true
    if [ ! -f "$BIN" ]; then
        fail_start "找不到启动器 ${BIN}。请重新安装本地版。"
        return 1
    fi
    if type fix_ownership_and_perms >/dev/null 2>&1; then
        fix_ownership_and_perms "$PKGVAR" "${PKGVAR}/.env" >/dev/null || true
    fi

    log_msg "Starting Octop (native) on port ${PORT} ..."

    if [ ! -f "${DATA_DIR}/.octop/octop.db" ] && [ ! -f "${DATA_DIR}/octop.db" ]; then
        log_msg "数据库尚未初始化，先执行 --prepare"
        if ! OCTOP_PORT="$PORT" OCTOP_BIND_HOST=0.0.0.0 run_as_service "$BIN" --prepare >> "${LOG_FILE}" 2>&1; then
            fail_start "首次初始化失败。请打开数据目录 octop-start-error.txt，或确认已安装「Python 3.12」。"
            return 1
        fi
    fi

    OCTOP_PORT="$PORT" OCTOP_BIND_HOST=0.0.0.0 run_as_service "$BIN" --host 0.0.0.0 --port "$PORT" >> "${LOG_FILE}" 2>&1 &
    octop_pid=$!

    local i
    for i in $(seq 1 "$START_WAIT_SECS"); do
        if port_ready; then
            printf "%s" "$octop_pid" > "${PID_FILE}"
            rm -f "${DATA_DIR}/octop-start-error.txt" "${PKGVAR}/last-error.txt"
            log_msg "Octop pid=$octop_pid 端口 ${PORT} 已就绪"
            return 0
        fi
        if ! kill -0 "$octop_pid" 2>/dev/null; then
            fail_start "进程已退出，未能监听 ${PORT}。请打开数据目录 octop-start-error.txt。"
            return 1
        fi
        sleep 1
    done

    kill -TERM "$octop_pid" 2>/dev/null || true
    fail_start "在 ${START_WAIT_SECS} 秒内未能监听 ${PORT}。请打开数据目录 octop-start-error.txt。"
    return 1
}

stop_process() {
    log_msg "Stopping Octop (native) ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
            for i in $(seq 1 10); do
                sleep 1
                if ! kill -0 "$pid" 2>/dev/null; then
                    break
                fi
            done
            if kill -0 "$pid" 2>/dev/null; then
                kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
            fi
        fi
        rm -f "${PID_FILE}"
    fi

    return 0
}

status() {
    [ -f "${PID_FILE}" ] && pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]') && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case $1 in
    start)  start_process ;;
    stop)   stop_process ;;
    status) status && exit 0 || exit 3 ;;
    *)      exit 1 ;;
esac
